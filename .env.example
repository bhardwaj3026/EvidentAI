# Server Port Configuration
PORT=8080

# Google Gemini API Keys (Get free keys at https://aistudio.google.com/)
# Configure multiple keys for parallel load balancing and automatic rate-limit (429/quota) failover:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
# You can also add more: GEMINI_API_KEY_3=... or comma-separated: GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Cloud Database (MongoDB Atlas)
# Connect your MongoDB URI to store user accounts & chat history in the cloud
# Leave blank to fallback to local data/users.json storage
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/evidentai?retryWrites=true&w=majority

# Optional alternative AI Providers (Server-side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
