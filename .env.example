# Server Port Configuration
PORT=8080

# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Cloud Database (MongoDB Atlas)
# Connect your MongoDB URI to store user accounts & chat history in the cloud
# Leave blank to fallback to local data/users.json storage
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/evidentai

# Optional alternative AI Providers (Server-side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
